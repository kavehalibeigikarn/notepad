<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- پشتیبان ابری گوگل خاموش است؛ پشتیبان‌گیری با فایل ZIP (و رمز) خود برنامه انجام می‌شود -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <!-- انتقال مستقیم گوشی‌به‌گوشی: یادداشت‌ها منتقل شوند، اما کلیدهای رمزشدهٔ مخصوص همین گوشی نه -->
    <device-transfer>
        <exclude domain="sharedpref" path="secure.xml" />
    </device-transfer>
</data-extraction-rules>
